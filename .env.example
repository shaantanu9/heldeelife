# Supabase
SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=your_sentry_dsn

# Upstash Redis (optional - for production rate limiting)
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend (Email delivery for abandoned cart recovery)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@heldeelife.com

# Blog Pipeline (Optional - for automated content generation)
REVALIDATION_SECRET=your_revalidation_secret_min_32_chars
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=your_anthropic_api_key
PIPELINE_DEFAULT_AUTHOR_ID=your_default_author_uuid

# SEO / GEO — business identity (used by metadata, JSON-LD, llms.txt, footer)
# Use the canonical production origin, no trailing slash (pick www OR apex and redirect the other)
# NEXT_PUBLIC_SITE_URL=https://heldeelife.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@heldeelife.com
NEXT_PUBLIC_SUPPORT_PHONE=+91-1800-123-4567
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_FOUNDING_YEAR=2024
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_CITY=Mumbai
NEXT_PUBLIC_BUSINESS_REGION=Maharashtra
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=400001
NEXT_PUBLIC_BUSINESS_LAT=19.0760
NEXT_PUBLIC_BUSINESS_LNG=72.8777

# Social profiles (become Organization.sameAs + footer links; leave blank to omit)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Search console verification tokens (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Razorpay webhook (Dashboard → Settings → Webhooks; events: payment.captured,
# payment.failed, order.paid; URL: https://<site>/api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
